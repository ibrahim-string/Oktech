PORT=3001
DB_PATH=./data/knot.db
# Claude API key for translation (https://platform.claude.com). Without it, text is shown untranslated.
ANTHROPIC_API_KEY=
# TRANSLATION_MODEL=claude-opus-5-5
# TRANSLATION_DISABLED=1
# Comma-separated origins allowed by CORS, e.g. https://knot.vercel.app (unset = allow all)
# CORS_ORIGIN=
# Seed demo data when the database is empty (set 0 to disable)
# AUTO_SEED=1
